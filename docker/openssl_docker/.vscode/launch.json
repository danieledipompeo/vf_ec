    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run with energy",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": ["--energy"],
            "console": "integratedTerminal"
        },
        {
            "name": "Run without energy",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": ["--force-recompute"],
            "console": "integratedTerminal"
        },
        {
            "name": "Run VIM without energy",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": ["--force-recompute", "--config", "config_vim.yaml"],
            "console": "integratedTerminal"
        }
    ]
}