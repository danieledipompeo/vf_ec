FROM ubuntu:24.04

COPY ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

RUN set -eux; \
    sed -i 's|http://archive.ubuntu.com/ubuntu|https://archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources; \
    sed -i 's|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential rsync wget curl \
        python3 python3-dev python3-pip \
        libdw-dev libunwind-dev \
        flex bison git pkg-config \
        libelf-dev libtraceevent-dev libncurses-dev \
        cmake libpcap-dev; \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git && \
    cd linux/tools/perf && \
    NO_JEVENTS=1 make && \
    cp perf /usr/bin && \
    cd / && rm -rf linux

COPY requirements.txt /app/
RUN pip3 install --no-cache-dir --break-system-packages -r /app/requirements.txt

# 2. Setup paths
WORKDIR /app

COPY openssl_pipeline.py common.py project.py logger.py config.yaml /app/

CMD ["python3", "openssl_pipeline.py"]
